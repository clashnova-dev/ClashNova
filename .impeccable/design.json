  "narrative": {
    "northStar": "",
    "overview": "ClashNova uses a restrained desktop workspace: persistent navigation, compact controls and readable operational data. The existing application icon and interface remain authoritative under PRODUCT.md. This record captures the built system; src/styles/app.css owns theme values and shared styles, while existing UI components own their interaction details.",
    "keyCharacteristics": [
      "System typography and compact hierarchy.",
      "Blue selection on neutral light and dark surfaces.",
      "Bounded data regions with visible controls."
    ],
    "rules": [
      {
        "name": "The Theme Pair Rule.",
        "body": "Use the matching light or dark semantic token set together; selected backgrounds and accent text have separate roles.",
        "section": "colors"
      },
      {
        "name": "The Control Alignment Rule.",
        "body": "Dense data toolbars align search and select triggers at the same compact height.",
        "section": "layout"
      }
    ],
    "dos": [
